{
  "name": "pixelpress",
  "version": "0.5.0",
  "description": "Bulk image compression and transcoding to AVIF, WebP, JPEG, and PNG — globs, presets, responsive widths, transforms, animated WebP, size budgets, cache with pruning, watch, HTML reports, and picture snippets.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pixelpress": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "COMPARISON.md",
    "PLAN.md",
    "pixelpress.schema.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "image",
    "images",
    "compress",
    "compression",
    "optimize",
    "optimization",
    "avif",
    "webp",
    "jpeg",
    "png",
    "sharp",
    "responsive",
    "srcset",
    "picture",
    "transcode",
    "bulk",
    "batch",
    "glob",
    "preset",
    "schema",
    "watch",
    "cache",
    "animation",
    "report",
    "stdout",
    "lqip",
    "cli"
  ],
  "author": "Animesh Chakraborty",
  "license": "MIT",
  "homepage": "https://aotr.github.io/pixelpress/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotr/pixelpress.git"
  },
  "bugs": {
    "url": "https://github.com/aotr/pixelpress/issues"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
